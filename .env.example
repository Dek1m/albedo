# Albedo. Скопировать в .env — .env не коммитить.
SERVICE_NAME=albedo

# Слушать внутри контейнера (prod — все интерфейсы)
ALBEDO_LISTEN_HOST=0.0.0.0
ALBEDO_LISTEN_PORT=8080

# Публикация наружу (compose ports)
ALBEDO_PUBLISH_HOST=0.0.0.0
# Снаружи не 8080 — его уже держит belle REST
ALBEDO_PUBLISH_PORT=5173

# Бэкенд на app-net. Origin без path и без хвостового слэша.
# Браузер сюда НЕ ходит — только nginx внутри контейнера.
ALBEDO_API_URL=http://belle:8080

# Сборка образа (не нужны в runtime)
# CACHEBUST=1
# ALBEDO_GIT_REF=main
# ALBEDO_GIT_URL=https://github.com/Dek1m/albedo.git
